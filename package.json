{
  "name": "dc-prospect",
  "version": "1.4.0",
  "private": true,
  "description": "DC Prospect: desktop app (Windows, macOS, Linux) that runs a prospecting plan for any freelancer or small business (leads, e-mails, follow-ups, reports)",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "build:ts": "npm run clean && tsc -p tsconfig.json && tsc -p frontend/js/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p frontend/js/tsconfig.json --noEmit",
    "start": "npm run build:ts && electron .",
    "engine": "npm run build:ts && node out/backend/run.js",
    "mcp": "npm run build:ts && node out/backend/mcp-server.js",
    "check": "npm run build:ts && node out/backend/check.js",
    "build": "npm run build:ts && electron-builder --win nsis",
    "build:mac": "npm run build:ts && electron-builder --mac --publish never",
    "build:linux": "npm run build:ts && electron-builder --linux --publish never",
    "publish": "pwsh -NoProfile -File scripts/publish.ps1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "exceljs": "^4.4.0",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.2",
    "node-llama-cpp": "3.22.2",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3"
  },
  "productName": "DC Prospect",
  "author": "Djason CHERY",
  "license": "UNLICENSED",
  "homepage": "https://github.com/Djason16/dc-prospect",
  "main": "out/electron/main.js",
  "build": {
    "appId": "dev.djason-chery.prospection",
    "productName": "DC Prospect",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/electron/**",
      "out/backend/**",
      "out/frontend/**",
      "frontend/pages/**",
      "frontend/assets/**",
      "resources/**",
      "config.json",
      "package.json",
      "!**/*.ts",
      "!**/*.map",
      "!node_modules/@node-llama-cpp/win-x64-cuda/**",
      "!node_modules/@node-llama-cpp/win-x64-cuda-ext/**",
      "!node_modules/@node-llama-cpp/win-arm64/**",
      "!node_modules/@node-llama-cpp/linux-x64-cuda/**",
      "!node_modules/@node-llama-cpp/linux-x64-cuda-ext/**",
      "!node_modules/@node-llama-cpp/linux-arm64/**",
      "!node_modules/@node-llama-cpp/linux-armv7l/**",
      "!node_modules/@node-llama-cpp/linux-riscv64/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "executableName": "DC Prospect"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "DC-Prospect-Setup-${version}.exe",
      "shortcutName": "DC Prospect",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "DC-Prospect-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "DC-Prospect-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "executableName": "dc-prospect",
      "synopsis": "La prospection par e-mail faite à ta place",
      "maintainer": "Djason CHERY",
      "artifactName": "DC-Prospect-${version}-linux-x86_64.${ext}"
    }
  }
}
