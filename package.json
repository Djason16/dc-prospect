{
  "name": "dc-prospect",
  "version": "1.1.0",
  "private": true,
  "description": "DC Prospect: Windows app that runs a prospecting plan for any freelancer or small business (leads, e-mails, follow-ups, reports)",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "moteur": "node backend/run.mjs",
    "mcp": "node backend/mcp-server.mjs",
    "tester": "node backend/tester.mjs",
    "build": "electron-builder --win nsis",
    "publier": "pwsh -NoProfile -File scripts/publier.ps1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "exceljs": "^4.4.0",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.2",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "productName": "DC Prospect",
  "author": "Djason CHERY",
  "main": "electron/main.mjs",
  "build": {
    "appId": "dev.djason-chery.prospection",
    "productName": "DC Prospect",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "backend/**",
      "frontend/**",
      "ressources/**",
      "config.json",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "executableName": "DC Prospect"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "DC-Prospect-Setup-${version}.exe",
      "shortcutName": "DC Prospect",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
